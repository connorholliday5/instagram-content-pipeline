{
  "expo": {
    "name": "TheWatchTower",
    "slug": "watchtower-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thewatchtower.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.thewatchtower.app"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TheWatchTower to access your photos.",
          "savePhotosPermission": "Allow TheWatchTower to save finished slides to your Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
